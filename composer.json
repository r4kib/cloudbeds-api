{
  "name": "r4kib/cloudbeds-api",
  "description": "cloudbeds.com API wrapper for PHP",
  "keywords": [
    "PHP",
    "cloudbeds.com",
    "cloudbeds",
    "API",
    "Wrapper"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "rakib hasan",
      "email": "rakib.hbo@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "guzzlehttp/guzzle": "^8.1",
    "league/oauth2-client": "^2.9"
  },
  "autoload": {
    "psr-4": {
      "R4kib\\Cloudbeds\\": "src/"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload-dev": {
    "psr-4": {
      "R4kib\\Cloudbeds\\Test\\": "test/src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "R4kib\\Cloudbeds\\CloudbedsServiceProvider"
      ]
    }
  },
  "suggest": {
    "illuminate/support": "Required to use the Laravel service provider (^13.0)."
  },
  "scripts": {
    "test": "phpunit"
  }
}
